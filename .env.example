# Copy to .env and adjust. Never commit the real .env.

# --- PostgreSQL (used by Docker or local PostgreSQL) ---
POSTGRES_USER=nexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nexus

# --- Backend Database URLs ---
# Inside Docker the database host is "db". For running the backend directly on your host, use localhost.
DATABASE_URL=postgresql+psycopg://nexus:change-me@localhost:5432/nexus
# Separate database used by pytest. Never point this at production data.
TEST_DATABASE_URL=postgresql+psycopg://nexus:change-me@localhost:5432/nexus_test

# --- App Settings ---
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
DEFAULT_USER_EMAIL=local@nexus.ai
DEFAULT_USER_NAME=Local User
REMINDER_POLL_INTERVAL_SECONDS=10.0

# --- AI & LLM Settings ---
# Provider selection: "gemini" or "mock" (offline testing)
LLM_PROVIDER=gemini
# Official Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key-here
# Google Gemini Model Name
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_HISTORY_MESSAGES=20
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=2048

# --- Frontend ---
VITE_API_URL=http://localhost:8000
